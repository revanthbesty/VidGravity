# Copy to .env.production on the server; never commit the real file.
VIDGRAVITY_DOMAIN=vidgravity.example.com
VIDGRAVITY_BASIC_AUTH_USER=operator
# Generate with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'use-a-long-unique-password'
# Paste the resulting bcrypt hash below; do not put a plaintext password here.
VIDGRAVITY_BASIC_AUTH_HASH='$2a$14$REPLACE_WITH_REAL_CADDY_BCRYPT_HASH'
# Razorpay secrets are not wired into this deployment scaffold; configure them only after verifying
# the payment integration and webhook handling in the application. Do not invent production values.
