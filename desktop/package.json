{
  "name": "vidgravity-desktop",
  "version": "1.0.0",
  "description": "VidGravity cloud-connected Windows desktop app",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win portable appx"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.vidgravity.desktop",
    "productName": "VidGravity",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "appx",
          "arch": ["x64"]
        }
      ],
      "artifactName": "VidGravity-Windows-${version}.${ext}"
    },
    "portable": {
      "artifactName": "VidGravity-Windows-${version}-portable.${ext}"
    },
    "appx": {
      "applicationId": "VidGravity",
      "identityName": "Revanth.VidGravity",
      "publisher": "CN=F1FBB9A9-B97A-41AA-8516-4E62A0603245",
      "publisherDisplayName": "Revanth",
      "backgroundColor": "#100d1c",
      "showNameOnTiles": true,
      "languages": ["en-US"],
      "minVersion": "10.0.17763.0",
      "maxVersionTested": "10.0.26100.0"
    }
  }
}
